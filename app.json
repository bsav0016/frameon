{
  "expo": {
    "name": "FrameOn",
    "slug": "frameon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frameon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "BrianSavidge.FrameOnNew",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "FrameOn uses the camera so you can photograph your artwork and profile picture.",
        "NSPhotoLibraryUsageDescription": "FrameOn uses your photo library so you can post artwork and choose a profile picture."
      }
    },
    "android": {
      "package": "com.brainsavidge.frameonnew",
      "adaptiveIcon": {
        "backgroundImage": "./assets/images/android-background.png",
        "foregroundImage": "./assets/images/android-foreground.png",
        "monochromeImage": "./assets/images/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8D9A0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FrameOn uses your photo library so you can post artwork and choose a profile picture.",
          "cameraPermission": "FrameOn uses the camera so you can photograph your artwork and profile picture."
        }
      ],
      "expo-mail-composer",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.BrianSavidge.FrameOnNew",
          "enableGooglePay": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5A2B"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Stripe's React Native SDK references push-provisioning classes that are not bundled (we do not use that feature).\n-dontwarn com.stripe.android.pushProvisioning.**"
          },
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e3ca509d-d2ca-4ad2-8769-71faa928d9b3"
      }
    },
    "owner": "bsav0016",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e3ca509d-d2ca-4ad2-8769-71faa928d9b3"
    }
  }
}